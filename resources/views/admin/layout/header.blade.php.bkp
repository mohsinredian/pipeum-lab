    $(document).ready(function () {
        // Add click event listener to the welcome text
        $('.welcomeText').on('click', function () {
            // Trigger the modal opening
            $('#myModal').modal('show');
        });
    });

</script>
<script>
 
function setButtonLoading(btn, isLoading) {
    const $btn = $(btn);
    $btn.prop('disabled', isLoading);
    $btn.find('.spinner-border').toggleClass('d-none', !isLoading);
    $btn.find('.btn-text').toggleClass('d-none', isLoading);
}
 
$(document).ready(function () {
 
    const emailModal = new bootstrap.Modal(document.getElementById('emailModal'));
    const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
    const passwordModal = new bootstrap.Modal(document.getElementById('passwordModal'));
 
    $('#passwordChangeBtn').on('click', function (e) {
        e.preventDefault();
        emailModal.show();
    });
 
    // SEND OTP
    $('#sendOtpBtn').on('click', function () {
 
        const btn = this;
 
        setButtonLoading(btn, true);
        let formData = new FormData();
        formData.append('email', $('#email').val());
 
        $.ajax({
            url: '{{ route("password.sendOtp") }}',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function (res) {
                if (res.status) {
                    emailModal.hide();
                    otpModal.show();
                    setButtonLoading(btn, false);
                } else {
                    alert(res.message);
                    setButtonLoading(btn, false);
                }
            }
        });
    });
 
    // VERIFY OTP
    $('#verifyOtpBtn').on('click', function () {
        let formData = new FormData();
        formData.append('otp', $('#otp').val());
 
        $.ajax({
            url: '{{ route("password.verifyOtp") }}',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function (res) {
                if (res.status) {
                    otpModal.hide();
                    passwordModal.show();
                } else {
                    alert(res.message);
                }
            }
        });
    });
 
    // CHANGE PASSWORD
    $('#changePasswordBtn').on('click', function () {
        let formData = new FormData();
        formData.append('current_password', $('#current_password').val());
        formData.append('new_password', $('#new_password').val());
        formData.append('confirm_password', $('#confirm_password').val());
 
        $.ajax({
            url: '{{ route("password.change") }}',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            success: function (res) {
                alert(res.message);
                if (res.status) {
                    passwordModal.hide();
                }
            }
        });
    });
 
});
 
 
</script>
