<script>
        function remove_mat_data(a)
        {
            var id = a.id;
            var amount = $("#" + id).val() || 0;
            var total = $("#total_budget_both").val() || 0;
            total = total.replace(/[^a-zA-Z0-9_ ]/g, "");
            tot = parseInt(total)-parseInt(amount);
            $("#total_budget_both").val(tot.toLocaleString('en-IN'));

        }

        function remove_ser_data(b)
        {
            var id = b.id;
            var amount = $("#" + id).val() || 0;
            var total = $("#total_budget_both").val() || 0;
            total = total.replace(/[^a-zA-Z0-9_ ]/g, "");
            var total_ser = $("#total_budget_service").val() || 0;
            total_ser = total_ser.replace(/[^a-zA-Z0-9_ ]/g, "");
            tot = parseInt(total)-parseInt(amount);
            tot_ser = parseInt(total_ser)-parseInt(amount);
            $("#total_budget_both").val(tot.toLocaleString('en-IN'));
            $("#total_budget_service").val(tot_ser.toLocaleString('en-IN'));

        }


        
    </script>
<script>
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();
    if (dd < 10) {
        dd = '0' + dd
    }
    if (mm < 10) {
        mm = '0' + mm
    }
    today = yyyy + '-' + mm + '-' + dd;
    document.getElementById("derc_app_date").setAttribute("max", today);
    </script>

<script>
                                                       
document.addEventListener('change', function(event) {
    
    if (event.target && event.target.classList.contains('pdf_order')) {
        var maxSize = 5 * 1024 * 1024; // 5 MB in bytes
        
        var file = event.target.files[0];

        if (file) {
            var fileSize = file.size;
            var fileType = file.type;

            if (fileSize > maxSize) {
                Swal.fire({
                    icon: 'error',
                
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK',
                    html: '<p style="color: red;">File size must be less than 5 MB.</p>'
                }).then(function () {
                    event.target.value = ''; // Clear the input
                });
            }
        }
    }
});
</script>

