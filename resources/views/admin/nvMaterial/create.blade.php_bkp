<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dercApproval = document.getElementById('derc_approval');
        const propNumber = document.getElementById('prop_number');
         const derc_ref_no = document.getElementById('derc_ref_no');
          const derc_app_date = document.getElementById('derc_app_date');

        function togglePropNumber() {
            if (dercApproval.value == 'Not Required' || dercApproval.value == 'Pre Approved Buckets' || dercApproval.value == 'DPR Not Submitted') {
                propNumber.value = '';
                derc_ref_no.value = '';
                derc_app_date.value = '';
                propNumber.disabled = true;
                derc_ref_no.disabled = true;
                derc_app_date.disabled = true;
            }else if(dercApproval.value == 'DPR Submitted' ){
                derc_ref_no.value = '';
                derc_app_date.value = '';
                propNumber.disabled = false;
                derc_ref_no.disabled = true;
                derc_app_date.disabled = true;
            } else {
                propNumber.value = '';
                propNumber.disabled = true;
                derc_ref_no.disabled = false;
                derc_app_date.disabled = false;
            }
        }

        // Initial check on page load
        togglePropNumber();

        // Add event listener for change event
        dercApproval.addEventListener('change', togglePropNumber);
    });

    document.addEventListener('DOMContentLoaded', () => {
    // List of fields with their max character limits
    const fields = [
        { id: 'proposal_name', countId: 'proposal_count', maxLength: 200 },
        { id: 'benefit', countId: 'benefit_count', maxLength: 2500 },
        { id: 'new_product_text', countId: 'new_product_text_count', maxLength: 200 },
        { id: 'quant_just_text', countId: 'quant_just_text_count', maxLength: 200 },
        { id: 'cause_analysis', countId: 'cause_analysis_count', maxLength: 1000 },
        { id: 'root_cause_analysis', countId: 'root_cause_analysis_count', maxLength: 1000 },
        { id: 'special_remarks', countId: 'special_remarks_count', maxLength: 500 },
    ];

    // Initialize character count for each field
    fields.forEach(field => {
        const element = document.getElementById(field.id);
        const countElement = document.getElementById(field.countId);

        if (element && countElement) {
            // Update count on page load
            updateCharCount(element.value.length, countElement, field.maxLength);

            // Update count on input change
            element.addEventListener('input', () => {
                const contentLength = element.value.length;
                updateCharCount(contentLength, countElement, field.maxLength);
            });
        }
    });

    function updateCharCount(length, countElement, maxLength) {
        countElement.textContent = `${length} / ${maxLength} characters`;
    }
});
</script>
<script>
$(document).ready(function() {
    $(document).on('click', '[id^=remove]', function(e) {
        e.preventDefault(); 
        
        const buttonId = $(this).attr('id'); 
        const index = buttonId.replace('remove', ''); 
        const nv_id = $('#nv_id').val();
        const material_id = $('#service_id').val();
        $.ajax({
            url: '/admin/nv_material/removeMaterialAmount', 
            type: 'POST',
            data: {
                index: index,
                nv_id:nv_id,
                material_id:material_id,
                _token: '{{ csrf_token() }}'
            },
            success: function(response) {
                if (response.success) {
                Swal.fire({
                    text: "Material Amount and Description Fields are Removed Successfully.",
                    type: 'success',
                    buttonsStyling: false,
                    confirmButtonText: "OK",
                    confirmButtonClass: "btn font-weight-bold btn-primary"
                    }).then(function () {
                        window.location.reload();
                    });
                $(this).closest('.row').remove(); 
                } else {
                    alert(response.message);
                }
            },
            error: function(xhr) {
                // Handle error
                alert('An error occurred while removing the item.');
            }
        });
    });

