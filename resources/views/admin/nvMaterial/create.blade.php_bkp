<script>
    document.querySelectorAll('.decimal').forEach(function (input) {
    input.addEventListener('input', function () {
        let v = this.value;

        // remove invalid characters
        v = v.replace(/[^0-9.]/g, '');

        // allow only one dot
        const parts = v.split('.');
        if (parts.length > 2) {
            v = parts[0] + '.' + parts[1];
        }

        // limit to 2 decimal places
        if (parts[1] !== undefined) {
            parts[1] = parts[1].slice(0, 2);
            v = parts[0] + '.' + parts[1];
        }

        this.value = v;
    });
});
</script>

