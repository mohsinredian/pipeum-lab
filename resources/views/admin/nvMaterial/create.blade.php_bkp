                                                   @endphp
                                                   @if($nv->budgetary_provision=="Approved")
                                                   @php 
                                                    $current_year =  date('Y');
                                                    $yearM = explode('-',$nv->fiscal_year);
                                                    $index1 = ($yearM[0]+1) - $current_year;
                                                    $index2 = ($yearM[0]+2) - $current_year;
                                                    $nextStartYear1 = $yearM[0] + 1;
                                                    $nextEndYear1 = $yearM[1] + 1;
                                                    $nextStartYear2 = $yearM[0] + 2;
                                                    $nextEndYear2 = $yearM[1] + 2;
                                                    $nextYear1 = "{$nextStartYear1}-{$nextEndYear1}";
                                                    $nextYear2 = "{$nextStartYear2}-{$nextEndYear2}";

                                                   if($nv->budget_type == "CAPEX"){
                                                    $capex = App\Models\Capex::where('department_id', $nv->department_id)->first('revised_budget');
                                                        $capex_values = explode(',', $capex->revised_budget);

                                                        function getRevisedBudget($department_id, $fiscal_year, $capex_values, $index) {
                                                            $existing_budget = App\Models\Budget::where('dept_id', $department_id)
                                                                                ->where('fiscal_year', $fiscal_year)
                                                                                ->where('budget_type', 'CAPEX')
                                                                                ->first();

                                                            if ($existing_budget) {
                                                                $budget_avl = $existing_budget->budget_avl;
                                                                $total_budget = $existing_budget->total_budget;
                                                                return !empty($total_budget) ? ($budget_avl - $total_budget) : $budget_avl;
                                                            } else {
                                                                return $capex_values[$index] ?? 0;
                                                            }
                                                        }

                                                        $revised_budget1 = getRevisedBudget($nv->department_id, $nextYear1, $capex_values, $index1);
                                                        $revised_budget2 = getRevisedBudget($nv->department_id, $nextYear2, $capex_values, $index2);
                                                   
                                                   }else{
                                                    $opex = App\Models\Opex::where('department_id',$nv->department_id)->first('revised_budget');
                                                    $opex_values = explode(',', $opex->revised_budget);

                                                    function getRevisedBudget($department_id, $fiscal_year, $opex_values, $index) {
                                                            $existing_budget = App\Models\Budget::where('dept_id', $department_id)
                                                                                ->where('fiscal_year', $fiscal_year)
                                                                                ->where('budget_type', 'OPEX')
                                                                                ->first();

                                                            if ($existing_budget) {
                                                                $budget_avl = $existing_budget->budget_avl;
                                                                $total_budget = $existing_budget->total_budget;
                                                                return !empty($total_budget) ? ($budget_avl - $total_budget) : $budget_avl;
                                                            } else {
                                                                return $opex_values[$index] ?? 0;
                                                            }
                                                        }

                                                        $revised_budget1 = getRevisedBudget($nv->department_id, $nextYear1, $opex_values, $index1);
                                                        $revised_budget2 = getRevisedBudget($nv->department_id, $nextYear2, $opex_values, $index2);
                                                    }
