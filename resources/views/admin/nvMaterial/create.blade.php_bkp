                    });
                $(this).closest('.row').remove(); 
                } else {
                    alert(response.message);
                }
            },
            error: function(xhr) {
                // Handle error
                alert('An error occurred while removing the item.');
            }
        });
    });
    
    //Scheme Details Remove 
