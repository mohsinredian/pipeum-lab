<script>
   $(document).ready(function () {
    $("#approved_budget").on("input change", function () {
        // Helper: safely parse numeric values (handles commas, blanks, etc.)
        function parseNum(val) {
            return parseFloat((val || "0").toString().replace(/,/g, "")) || 0;
        }

        let approved_budget = parseNum($("#approved_budget").val());
        let total_budget = parseNum($("#total_budget_both").val());
        let total_mat_mat = parseNum($("#total_mat_mat").val());
        let total_ser_amo = parseNum($("#total_ser_amo").val());
        let tax1 = parseNum($("#tax1").val());
        let tax6 = parseNum($("#tax6").val());
        let CheckYes = parseNum($("#CheckYes").val());
        let year3 = $("#year3").val() || "";

        // Tax inclusion (if you need)
        /*
        if (tax1 > 0) total_mat_mat += (total_mat_mat * tax1) / 100;
        if (tax6 > 0) total_ser_amo += (total_ser_amo * tax6) / 100;
        */

        $(".approved_budget_error").html(""); // clear old error by default

        // ✅ Validation Rules
        if (CheckYes === 3 && approved_budget > total_mat_mat) {
            $(".approved_budget_error").html(
                `Approved Budget should not be greater than FY ${year3} Amount`
            );
            $("#add_budget").val("0.00");
            return;
        }

        if (CheckYes === 2 && approved_budget > (total_budget)) {
            $(".approved_budget_error").html(
                `Approved Budget should not be greater than FY (${year3}) Material + Service Amount`
            );
            $("#add_budget").val("0.00");
            return;
        }

        // ✅ Calculation (always calculate even if approved_budget = 0)
        let total = total_budget - approved_budget;
        $("#add_budget").val(total.toFixed(2));
    });



   function parseNumber(val) {
    // Accept numbers like "1,234.56", "₹ 1,234.56", " 1234 ", "-12.3" etc.
    if (val === null || val === undefined) return 0;
    val = String(val).trim();
    if (val === "") return 0;
    // Remove anything that's not digit, minus or dot
    val = val.replace(/[^\d.-]/g, "");
    // If more than one dot or minus, fallback to 0
    if ((val.match(/\./g) || []).length > 1) return 0;
    if ((val.match(/-/g) || []).length > 1) return 0;
    var n = Number(val);
    return isFinite(n) ? n : 0;
}

function calculateBudget() {
    // read raw values and parse safely
    var approved_budget = parseNumber($("#approved_budget").val());
    var total_budget = parseNumber($("#total_budget_both").val());
    var total_mat_mat = parseNumber($("#total_mat_mat").val());
    var total_ser_amo = parseNumber($("#total_ser_amo").val());
    var tax1 = parseNumber($("#tax1").val());
    var tax6 = parseNumber($("#tax6").val());
    var CheckYes = parseNumber($("#CheckYes").val()); // numeric compare

    // Optional: if you want to include tax in the material/service totals,
    // enable these lines (uncomment). By default they are OFF.
    // total_mat_mat = total_mat_mat + ((total_mat_mat * tax1) / 100);
    // total_ser_amo = total_ser_amo + ((total_ser_amo * tax6) / 100);

    var remaining = 0;

    // if (!isNaN(approved_budget) && approved_budget > 0) {
        if (CheckYes === 3 && approved_budget <= total_mat_mat) {
            remaining = total_budget - approved_budget;
        } else if (CheckYes === 2 && approved_budget <= (total_mat_mat + total_ser_amo)) {
            remaining = total_budget - approved_budget;
        } else {
            remaining = 0;
        }
    // } else {
    //     remaining = 0;
    // }

    // write result: keep integers as-is, decimals to 2 places
    var out;
    if (Math.abs(remaining % 1) > 0) {
        out = remaining.toFixed(2);
    } else {
        // keep it an integer-like string, but ensure no "-0" artifact
        out = String(Math.round(remaining));
    }

    $("#add_budget").val(out);
}



    $("#refreshButton").click(function() {
        calculateBudget();
    });

    var total_value = parseFloat($('#total_budget_both').val());
    $('#tax1').change(function () {
    var amount = parseFloat($('#total_mat_mat').val());
    var taxPercentage = parseFloat($(this).val());
   
    if (!isNaN(amount) && !isNaN(taxPercentage)) {
        var taxAmount = amount + parseFloat((amount * taxPercentage) / 100);
        $('#total_budget_both').val(taxAmount);
    }else{
        $('#total_budget_both').val(total_value);
    }
    });

    $('#tax_amount2').change(function () {
