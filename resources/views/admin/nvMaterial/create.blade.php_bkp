    if (!isNaN(amount) && !isNaN(taxPercentage)) {
        var taxAmount = amount +  parseFloat((amount * taxPercentage) / 100);
        $('#total_budget_both').val(taxAmount);
    }else{
        $('#total_budget_both').val(total_value);
    }
    });
    $('#tax6').change(function () {
    var amount = parseFloat($('#total_ser_amo').val());
    var taxPercentage = parseFloat($(this).val());
   
    if (!isNaN(amount) && !isNaN(taxPercentage)) {
