<script>
    //Rate calculation for ServiceBOQ
    function sumSolar() {
        var sce = $('#ser_rate').val();
        var sca = $('#ser_quantity').val();
        var sum = (1 * sce) * (1 * sca);
        $('#ser_total_amount').val(sum);
    }

    function autofetchServiceCode() {
        var token = "{{ csrf_token() }}";
        var service_code = $("#service_code_0").val();
        if (service_code.length >= 6) {
            $.ajax({
                url: "{{ route('capex.auto.fetch.servicedata') }}",
                type: 'post',
                dataType: "json",
                data: {
                    '_token': token,
                    'key': service_code,
                },
                success: function(data) {
                    //response(data);
                    $('#ser_des_0').val(data.service_short_text);
                    $('#ser_uom_0').val(data.bun);
                    $('#ser_rate').val(data.rate_ser);
                }
            });

        }
    };
</script>
<script>
    $(document).ready(function() {
        $('.download-all').on('click', function(e) {
            e.preventDefault();

            var fileData = $(this).data('files');
            if (!fileData) return;

            var files = fileData.split(',');
            downloadFiles(files);
        });

        function downloadFiles(files) {
            var link = document.createElement('a');
            link.style.display = 'none';

            document.body.appendChild(link);

            for (var i = 0; i < files.length; i++) {
                link.setAttribute('href', '{{ url('
                    services - doc / ') }}/' + files[i]);
                link.setAttribute('download', files[i]);
                link.click();
            }

            document.body.removeChild(link);
        }
    });
</script>
<script>
    $(document).ready(function() {
        $('#add').click(function() {
            $('#details').toggle();
        });

    });

    let previousValues = {};

    function sumSolarCap_2() {
        var amount1 = parseFloat($('#estimate_amount_of_service').val());
        var taxPercentage1 = parseFloat($('#tax1').val());
        if (!isNaN(amount1) && !isNaN(taxPercentage1)) {
            var taxAmount1 = ((amount1 * taxPercentage1) / 100) || 0;
        }
        var amount2 = parseFloat($('#estimate_amount_of_service_civil').val());
        var taxPercentage2 = parseFloat($('#tax2').val());
        if (!isNaN(amount2) && !isNaN(taxPercentage2)) {
            var taxAmount2 = ((amount2 * taxPercentage2) / 100) || 0;
        }

        var amount3 = parseFloat($('#estimate_amount_of_rr_chnage').val());
        var taxPercentage3 = parseFloat($('#tax3').val());
        if (!isNaN(amount3) && !isNaN(taxPercentage3)) {
            var taxAmount3 = ((amount3 * taxPercentage3) / 100) || 0;
        }
        var amount4 = parseFloat($('#estimate_amount_other').val());
        var taxPercentage4 = parseFloat($('#tax4').val());
        if (!isNaN(amount4) && !isNaN(taxPercentage4)) {
            var taxAmount4 = ((amount4 * taxPercentage4) / 100) || 0;
        }

        var implementsYears = parseInt($("#exampleFormControlSelect").val()) || 0;
        var bgt_prov = $('#bgt_prov').val();

        if (bgt_prov == "Additional" || implementsYears == 0) {
            var amount5 = parseFloat($('#total_ser_amo').val());
            var taxPercentage5 = parseFloat($('#tax5').val());
            if (!isNaN(amount5) && !isNaN(taxPercentage5)) {
                var taxAmount5 = ((amount5 * taxPercentage5) / 100) || 0;
            }
            var service_budget = Number(document.getElementById('total_ser_amo').value) || 0;
            var total_matyear1 = 0;
            var total_matyear2 = 0;
            var total_matyear3 = 0;
        } else {

            var tax_amount1 = parseFloat($('#tax_amount1').val()) || 0;
            var tax_amount2 = parseFloat($('#tax_amount2').val()) || 0;
            var tax_amount3 = parseFloat($('#tax_amount3').val()) || 0;
            if (implementsYears == 1) {
                // var total_matyear1 = Number(document.getElementById('total_matyear1').value) || 0;
                var total_matyear1 = parseFloat($('#total_matyear1').val()) || 0;
                if (!isNaN(total_matyear1) && !isNaN(tax_amount1)) {
                    var total_matyear1 = total_matyear1 + ((total_matyear1 * tax_amount1) / 100) || 0;
                } else {
                    var total_matyear1 = total_matyear1 || 0;
                }
                var total_matyear2 = 0;
                var total_matyear3 = 0;
                var service_budget = 0;
                var taxAmount5 = 0;
            } else if (implementsYears == 2) {
                // var total_matyear1 = Number(document.getElementById('total_matyear1').value) || 0;
                var total_matyear1 = parseFloat($('#total_matyear1').val()) || 0;
                if (!isNaN(total_matyear1) && !isNaN(tax_amount1)) {
                    var total_matyear1 = total_matyear1 + ((total_matyear1 * tax_amount1) / 100) || 0;
                } else {
                    var total_matyear1 = total_matyear1 || 0;
                }
                // var total_matyear2 = Number(document.getElementById('total_matyear2').value) || 0;
                var total_matyear2 = parseFloat($('#total_matyear2').val()) || 0;
                if (!isNaN(total_matyear2) && !isNaN(tax_amount2)) {
                    var total_matyear2 = total_matyear2 + ((total_matyear2 * tax_amount2) / 100) || 0;
                } else {
                    var total_matyear2 = total_matyear2 || 0;
                }
                var total_matyear3 = 0;
                var service_budget = 0;
                var taxAmount5 = 0;
            } else if (implementsYears == 3) {
                // var total_matyear1 = Number(document.getElementById('total_matyear1').value) || 0;
                var total_matyear1 = parseFloat($('#total_matyear1').val()) || 0;
                if (!isNaN(total_matyear1) && !isNaN(tax_amount1)) {
                    var total_matyear1 = total_matyear1 + ((total_matyear1 * tax_amount1) / 100) || 0;
                } else {
                    var total_matyear1 = total_matyear1 || 0;
                }
                // var total_matyear2 = Number(document.getElementById('total_matyear2').value) || 0;
                var total_matyear2 = parseFloat($('#total_matyear2').val()) || 0;
                if (!isNaN(total_matyear2) && !isNaN(tax_amount2)) {
                    var total_matyear2 = total_matyear2 + ((total_matyear2 * tax_amount2) / 100) || 0;
                } else {
                    var total_matyear2 = total_matyear2 || 0;
                }
                // var total_matyear3 = Number(document.getElementById('total_matyear3').value) || 0;
                var total_matyear3 = parseFloat($('#total_matyear3').val()) || 0;
                if (!isNaN(total_matyear3) && !isNaN(tax_amount3)) {
                    var total_matyear3 = total_matyear3 + ((total_matyear3 * tax_amount3) / 100) || 0;
                } else {
                    var total_matyear3 = total_matyear3 || 0;
                }
                var service_budget = 0;
                var taxAmount5 = 0;
            }
        }


        var estimateSerAmoCivil = Number(document.getElementById('estimate_amount_of_service_civil').value) || 0;
        var estimateAmountOfService = Number(document.getElementById('estimate_amount_of_service').value) || 0;
        var estimateAmountOfRRCharge = Number(document.getElementById('estimate_amount_of_rr_chnage').value) || 0;
        var estimateAmountOther = Number(document.getElementById('estimate_amount_other').value) || 0;
        var totalBudgetNV = Number(document.getElementById('total_buget').value) || 0;
        let service_amount = 0;
        document.querySelectorAll('input[name="service_amount[]"]').forEach(function(input) {
            const value = parseFloat(input.value) || 0;
            service_amount += value;
        });
        var sum = service_amount + service_budget +
            estimateSerAmoCivil + estimateAmountOfService +
            estimateAmountOfRRCharge + estimateAmountOther;
var sumdata = total_matyear3 + total_matyear2 + total_matyear1;
        if (!isNaN(taxAmount1)) {
            sum = sum + taxAmount1;
        }
        if (!isNaN(taxAmount2)) {
            sum = sum + taxAmount2;
        }
        if (!isNaN(taxAmount3)) {
            sum = sum + taxAmount3;
        }
        if (!isNaN(taxAmount4)) {
            sum = sum + taxAmount4;
        }
        if (!isNaN(taxAmount5)) {
            sum = sum + taxAmount5;
        }
        var totalBudgetNV = document.getElementById('total_buget');

        if (totalBudgetNV.value !== sumdata.toString()) {
            if (sum % 1 != 0) {
                totalBudgetNV.value = sumdata.toFixed(2);
            } else {
                totalBudgetNV.value = sumdata;
            }
        }

        // if (totalBudgetNV.value !== sum.toString()) {
        //     if (sum % 1 != 0) {
        //         totalBudgetNV.value = sum.toFixed(2);
        //     } else {
        //         totalBudgetNV.value = sum;
        //     }
        // }
    }

    window.addEventListener('change', sumSolarCap_2);


    setInterval(function() {
        var currentValues = {};
        document.querySelectorAll('input[type="text"]').forEach(function(input) {
            currentValues[input.id] = input.value;
        });

        if (JSON.stringify(previousValues) !== JSON.stringify(currentValues)) {
            previousValues = currentValues;
            sumSolarCap_2();
        }
    }, 100);
</script>
