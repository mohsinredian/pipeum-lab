    function getCurrentFinancialYear(fiscalYearString) {
        // Parse the fiscal year string (e.g., "2024-25")
        var years = fiscalYearString.split('-');
        var startYear = parseInt(years[0]);
        var endYear = parseInt(years[0]) + 3
        var fiscalYearStart = new Date(startYear, 4 - 1, 2); // April 1st of the start year
        var fiscalYearEnd = new Date(endYear, 2, 32); // March 31st of the end year
        return {
            start: fiscalYearStart,
            end: fiscalYearEnd
        }
    }

    // Replace this with the dynamic value from your backend
    var fiscalYearString = "{{$nv->fiscal_year}}"; // e.g., "2024-25"
    var financialYear = getCurrentFinancialYear(fiscalYearString);
    var April = financialYear.start;
    var March = financialYear.end;

    function format(date) {
        return date.toISOString().split('T')[0];
    }
    // console.log("Financial Year Start Date:", formatDate(April));
    // console.log("Financial Year End Date:", formatDate(March));

    var checkin = [];
    var checkout = [];

    function formatDate(date) {
        return date.toISOString().split("T")[0];
    }
    $(function() {

        $('#amc_proposal_sdate').on('change', function() {
            var selectedDate = new Date($(this).val());
            selectedDate.setDate(selectedDate.getDate() + 1);
            var minDate = formatDate(selectedDate);
            $('#amc_proposal_edate').attr('min', minDate);
            $('#amc_proposal_edate').val('');
        });


        $('#amc_proposal_edate').on('change', function() {
            var selectedDate = new Date($(this).val());
            selectedDate.setDate(selectedDate.getDate() - 1);
            var maxDate = formatDate(selectedDate);
            $('#amc_proposal_sdate').attr('max', maxDate);
        });
    });

    function setMinimum() {
        $("#amc_proposal_sdate").each(function() {
            $(this).attr("min", format(April));
            $(this).attr("max", format(March));
            const impToInput = $(this).parent().parent().next().find("#amc_proposal_sdate");
            const fromValue = $(this).val();
            if (fromValue) {
                impToInput.attr("min", fromValue);
                impToInput.attr("max", fromValue);
            } else {
                impToInput.attr("min", format(April));
                impToInput.attr("max", format(March));
            }
        });

        $("#amc_proposal_edate").each(function() {
            $(this).attr("min", format(April));
            $(this).attr("max", format(March));
            const impToInput = $(this).parent().parent().next().find("#amc_proposal_edate");
            const fromValue = $(this).val();
            if (fromValue) {
                impToInput.attr("min", fromValue);
                impToInput.attr("max", fromValue);
            } else {
                impToInput.attr("min", format(April));
                impToInput.attr("max", format(March));
            }
        });
    }

    setMinimum();

    $(function() {
        const dynamicIdFrom = "imp_from" + 1;
        const dynamicIdTo = "imp_to" + 1;
        // Set the minimum and maximum date for amc_prop_start_date
        $(" #imp_from").on('change', function() {
            var selectedDate = new Date($(this).val());
            selectedDate.setDate(selectedDate.getDate() + 1);
            var minDate = formatDate(selectedDate);
            // console.log(minDate);
            $(" #imp_to").attr('min', minDate);
            $(" #imp_to").val('');
        });



        // Set the minimum and maximum date for imp_to
        $(" #imp_to").on('change', function() {
            var selectedDate = new Date($(this).val());
            selectedDate.setDate(selectedDate.getDate() - 1);
            var maxDate = formatDate(selectedDate);
            $(" #imp_from").attr('max', maxDate);
            var selectedDate = new Date($(this).val());
            selectedDate.setDate(selectedDate.getDate() + 1);
            var minDate = formatDate(selectedDate);
            // console.log(minDate);
            $("#" + dynamicIdFrom).attr('min', minDate);
            $("#" + dynamicIdFrom).val('');
        });

    });


    function setMinimumDates() {
        $(".after-add-more-third input[name='imp_to[]']").each(function() {
            $(this).attr("min", format(April));
            $(this).attr("max", format(March));
            const impToInput = $(this).parent().parent().next().find("input[name='imp_to[]']");
            const fromValue = $(this).val();
            if (fromValue) {
                impToInput.attr("min", fromValue);
                impToInput.attr("max", fromValue);
            } else {
                impToInput.attr("min", format(April));
                impToInput.attr("max", format(March));
            }
        });

        $(".after-add-more-third input[name='imp_from[]']").each(function() {
            $(this).attr("min", format(April));
            $(this).attr("max", format(March));
            const impToInput = $(this).parent().parent().next().find("input[name='imp_from[]']");
            const fromValue = $(this).val();
            if (fromValue) {
                impToInput.attr("min", fromValue);
                impToInput.attr("max", fromValue);
            } else {
                impToInput.attr("min", format(April));
                impToInput.attr("max", format(March));
            }
        });
    }

    $(document).on("click", ".add-more-third", function() {
        setMinimumDates();
    });
    setMinimumDates();
</script>
