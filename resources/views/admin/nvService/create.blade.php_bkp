<script>
    function validateDate(input) {
        const dateValue = input.value;
        const isValidDate = isValidDateFormat(dateValue); // Implement this function
        if (!isValidDate) {
            alert('Invalid date format. Please use yyyy-mm-dd.');
            input.value = ''; // Clear the input field
        }
    }


    function isValidDateFormat(dateString) {
        const regex = /^\d{4}-\d{2}-\d{2}$/;
        return regex.test(dateString);
    }
</script>

<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/ckeditor.js"></script>
<script>
    let editor1;

    ClassicEditor
        .create(document.querySelector('#just_of_proposal'))
        .then(newEditor => {
            editor1 = newEditor;
            const charCount3Element = document.getElementById('charCount3');
            const validationMessage3Element = document.getElementById('validationMessage3');

            // Initialize character count3
            updateCharCount3(getPlainTextLength(editor1.getData()));

            // Listen for changes in the editor
            editor1.model.document.on('change:data', () => {
                const content = editor1.getData();
                const contentLength = getPlainTextLength(content);

                updateCharCount3(contentLength);

            });

            function updateCharCount3(length) {
                charCount3Element.textContent = `${length} / 2500 characters`;
            }
        })
        .catch(error => {
            console.error(error);
        });

    let editor2;

    ClassicEditor
        .create(document.querySelector('#background'))
        .then(newEditor => {
            editor2 = newEditor;
            const charCount1Element = document.getElementById('charCount1');
            const validationMessage1Element = document.getElementById('validationMessage1');

            // Initialize character count1
            updateCharCount1(getPlainTextLength(editor2.getData()));

            // Listen for changes in the editor
            editor2.model.document.on('change:data', () => {
                const content = editor2.getData();
                const contentLength = getPlainTextLength(content);

                updateCharCount1(contentLength);

            });

            function updateCharCount1(length) {
                charCount1Element.textContent = `${length} / 2500 characters`;
            }
        })
        .catch(error => {
            console.error(error);
        });

    let editor3;

    ClassicEditor
        .create(document.querySelector('#broad_just'))
        .then(newEditor => {
            editor3 = newEditor;

            const charCount2Element = document.getElementById('charCount2');
            const validationMessage2Element = document.getElementById('validationMessage2');

            // Initialize character count2
            updateCharCount2(getPlainTextLength(editor3.getData()));

            // Listen for changes in the editor
            editor3.model.document.on('change:data', () => {
                const content = editor3.getData();
                const contentLength = getPlainTextLength(content);

                updateCharCount2(contentLength);

            });

            function updateCharCount2(length) {
                charCount2Element.textContent = `${length} / 500 characters`;
            }
        })
        .catch(error => {
            console.error(error);
        });

    function getPlainTextLength(htmlContent) {
        // Strip HTML tags and get plain text length
        const plainText = htmlContent.replace(/<[^>]*>?/gm, '');
        return plainText.length;
    }
</script>

<script>
    document.addEventListener('change', function(event) {

        if (event.target && event.target.classList.contains('pdf_order')) {
            var maxSize = 2 * 1024 * 1024; // 5 MB in bytes

            var file = event.target.files[0];

            if (file) {
                var fileSize = file.size;
                var fileType = file.type;

                if (fileSize > maxSize) {
                    Swal.fire({
                        icon: 'error',

                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'OK',
                        html: '<p style="color: red;">File size must be less than 2 MB.</p>'
                    }).then(function() {
                        event.target.value = ''; // Clear the input
                    });
                }
            }
        }
    });
</script>



