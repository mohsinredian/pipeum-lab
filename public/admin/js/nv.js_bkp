				},
				{
					data: 'su_status',
					name: 'su_status',
					className: "text-center"
				},
				
			],
			'columnDefs': [{ 'orderable': false, 'targets': 0 },{'visible': false, 'targets': [1], 'orderable': true}],
			'aaSorting': [[1, 'desc']]
		});
	}

	$("#divId").hide();
	$("#popUp").click(function () {
